# Sepolia deployer (needs a little test ETH for gas)
SEPOLIA_DEPLOYER_KEY=0x...
SEPOLIA_DEPLOYER_ADDR=0x...
# Optional: override the default public RPC
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Demo role accounts (four separate keys). The delegate & auditor keys are the
# ones intentionally embedded in the dApp's demo mode; admin & signer are the
# privileged roles and must NOT be published.
DEMO_ADMIN_KEY=0x...
DEMO_ADMIN_ADDR=0x...
DEMO_SIGNER_B_KEY=0x...
DEMO_SIGNER_B_ADDR=0x...
DEMO_DELEGATE_KEY=0x...
DEMO_DELEGATE_ADDR=0x...
DEMO_AUDITOR_KEY=0x...
DEMO_AUDITOR_ADDR=0x...

# Optional Fresh-run target balances. The deploy preflight reads each role's
# live balance, reserves only the missing top-up, and verifies the target after
# transfer. Defaults are based on the complete Deploy -> Smoke -> E2E run.
# Raise these independently if Sepolia gas prices increase. Overrides below
# these empirical floors are rejected before the first chain write.
# FRESH_ADMIN_TARGET_ETH=0.012
# FRESH_SIGNER_B_TARGET_ETH=0.010
# FRESH_DELEGATE_TARGET_ETH=0.012
# FRESH_AUDITOR_TARGET_ETH=0.001
# Optional isolated recovery journal for one Deploy -> Smoke -> E2E run.
# Never reuse a path for a different Fresh deployment.
# FRESH_RUN_CHECKPOINT_PATH=/absolute/private/path/fresh-run.json

# Optional keeper key (falls back to SEPOLIA_DEPLOYER_KEY)
# KEEPER_KEY=0x...
